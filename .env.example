# Copy to APP_PRIVATE_ROOT/audioRecorder.env (outside the web root).
# Process environment variables take precedence over values in this file.
# Keep the real file out of Git and readable only by the PHP service account.

# OpenAI project key for this environment.
OPENAI_API_KEY=

# Optional if ffmpeg is not at the platform default path.
# FFMPEG_BINARY=/usr/bin/ffmpeg
